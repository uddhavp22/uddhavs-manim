# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Only needed for `--voice eleven` / SIGREG_VOICE=eleven. The default draft
# voice is the offline macOS `say` binary and costs nothing, so every flag in
# this repo works without any key set.
ELEVEN_API_KEY=

# Only needed if a scene is switched to OpenAI's text-to-speech.
# OPENAI_API_KEY=
